# Rust / Tauri（工作区级 target 在仓库根）
/target/
/src-tauri/target/
/src-tauri/gen/schemas/

# Node / Bun
node_modules/
*.tsbuildinfo

# Frontend build output（tauri build 时由 beforeBuildCommand 生成）
/dist/
dist-ssr/

# dev:sandbox 的隔离数据目录
/.sandbox/

# Local overrides & secrets
.env.local
.env.*.local
*.local

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?

# 生成的架构图 / 文档产物（不进仓库）
/.archify/

# Misc
*.log
logs/
.DS_Store

# 本地开发用的 carter 路径覆盖（见 `.cargo/config.toml`），不进仓库
/.cargo/config.toml
