{
  "name": "carter-app",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "init": "bun run scripts/init.ts",
    "dev": "tauri dev",
    "dev:sandbox": "bun run scripts/sandbox.ts",
    "build": "bun run scripts/build.ts",
    "build:win": "bun run scripts/build.ts win",
    "build:mac": "bun run scripts/build.ts mac",
    "build:linux": "bun run scripts/build.ts linux",
    "build:debug": "bun run scripts/build.ts --debug",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "tauri": "tauri",
    "icon": "tauri icon",
    "check": "bun run lint && bun run typecheck && bun run fmt:check && bun run clippy",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt": "biome check --write . && cargo fmt --all",
    "fmt:check": "biome format . && cargo fmt --all --check",
    "fix": "biome check --write . && cargo fmt --all && cargo clippy --workspace --all-targets --fix --allow-dirty --allow-staged",
    "test": "bun run test:web && bun run test:rs",
    "test:web": "bun test --pass-with-no-tests",
    "test:rs": "cargo test --workspace",
    "test:core": "cargo test -p carter-app-core",
    "logs": "bun run scripts/logs.ts",
    "upgrade": "bun run scripts/upgrade.ts",
    "clean": "bun run scripts/clean.ts",
    "models:snapshot": "bun run scripts/models-snapshot.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
