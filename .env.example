# Copy to .env and adjust. Only loaded by debug builds; shipped installers
# never read it, so every variable must have a sane default in code.
# Put real secrets in .env.local (gitignored).

# 日志过滤（tracing EnvFilter 语法），写进 ~/.carter-app/app.log。看日志：bun run logs -f
CARTER_LOG=info,carter_app_core=debug,carter_app_lib=debug,carter=info

# 数据目录覆盖。平时不用设，`bun run dev:sandbox` 会自动指向 .sandbox/。
# CARTER_HOME=/path/to/.carter
# CARTER_APP_HOME=/path/to/.carter-app
